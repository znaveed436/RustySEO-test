# RustySEO - Environment Variables Template
# Copy this file to '.env' inside the root directory or inside 'src-tauri/'

# Google API Key (e.g., for PageSpeed Insights, Google Gemini API fallback)
# Note: Users can configure their API keys directly via the app's Settings GUI.
# This environment variable acts as a developer fallback.
GOOGLE_API_KEY=your_google_api_key_here
